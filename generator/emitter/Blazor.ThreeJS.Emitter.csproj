<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately outside src/Blazor.ThreeJS.slnx: this is build-time tooling, never built or shipped
    with the package. It is run by hand (or by CI) via the npm scripts in package.json.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Blazor.ThreeJS.Emitter</RootNamespace>
    <AssemblyName>Blazor.ThreeJS.Emitter</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
