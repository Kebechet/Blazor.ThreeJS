@attribute [Stories("Addons/GLTFLoader compression")]
@using System.Globalization
@inject NavigationManager _navigationManager

<Stories TComponent="ThreeCanvas">
    <Story Name="Load a Draco-compressed model">
        <Template>
            <p>
                A glTF file whose mesh was compressed with <code>KHR_draco_mesh_compression</code>.
                <code>GLTFLoader</code> does not decode that extension on its own - decoding it needs a
                separate DRACO decoder addon and its <code>.wasm</code> payload, which cost bytes nobody
                should pay for unless they load a compressed file. Passing
                <code>new GLTFLoadOptions { IsDracoEnabled = true }</code> to <code>LoadAsync</code> is
                what opts in: only then does this page fetch <code>DRACOLoader.js</code> and the decoder
                it wraps - about 264 KB in a WebAssembly-capable browser, which is every browser this
                package targets. A further ~500 KB, a pure-JavaScript fallback decoder for a browser
                with no WebAssembly, is vendored beside it but sits unfetched here.
            </p>
            <ThreeCanvas Style="width: 100%; height: 420px;" OnReady="BuildCompressedSceneAsync" />
            <p>
                Download reported:
                @if (_loadProgress is null)
                {
                    <em>no progress events</em>
                }
                else if (_loadProgress.Fraction is { } fraction)
                {
                    <text><strong>@fraction.ToString("P0", CultureInfo.InvariantCulture)</strong> (@_loadProgress.BytesLoaded of @_loadProgress.BytesTotal bytes)</text>
                }
                else
                {
                    <text><strong>@_loadProgress.BytesLoaded bytes</strong>, total unknown</text>
                }
            </p>
            <p>
                Drag to orbit, scroll to zoom. Nothing about interacting with a decoded model differs
                from an uncompressed one - <code>OrbitControls</code> and the mirror behind it never
                learn whether the geometry they are looking at arrived compressed or not.
            </p>
            <p>
                ⚠️ Leave <code>options</code> out of the call, or pass
                <code>new GLTFLoadOptions()</code>, and this same file does not quietly load without its
                geometry - it rejects the load outright with the browser's own
                <code>THREE.GLTFLoader: No DRACOLoader instance provided.</code> message. That is the
                documented behaviour for a compressed file nobody opted into decoding, and it is proved
                against the real vendored addon (both directions) by
                <code>tests/wire-format.test.mjs</code>.
            </p>
            <p>
                <code>KHR_texture_basisu</code> (KTX2-compressed textures) opts in the same way, through
                <code>IsKtx2Enabled</code>, wiring a <code>KTX2Loader</code> instead of a
                <code>DRACOLoader</code>. No small KTX2 sample ships with this demo, so that path is
                covered by <code>GLTFLoaderTests.cs</code> and <code>tests/wire-format.test.mjs</code>
                rather than by a story here.
            </p>
            <p>
                ⚠️ <strong>Box</strong>, © 2017 Cesium, licensed
                <a href="https://creativecommons.org/licenses/by/4.0/legalcode" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>,
                from the
                <a href="https://github.com/KhronosGroup/glTF-Sample-Assets" target="_blank" rel="noopener noreferrer">Khronos glTF-Sample-Assets</a>
                repository, re-exported with Draco compression by the same repository's
                <code>Box/glTF-Draco</code> variant.
            </p>
        </Template>
    </Story>
</Stories>

@code {
    // CC BY 4.0 (Cesium), committed under demo/wwwroot/models. Resolved against the app's base href so
    // the same story works locally and under the /Blazor.ThreeJS/ path on GitHub Pages.
    private const string ModelUrl = "models/box-draco.gltf";

    private GltfLoadProgress? _loadProgress;

    private async Task BuildCompressedSceneAsync(ThreeContext threeContext)
    {
        var scene = new Scene();
        threeContext.Attach(scene);

        var camera = new PerspectiveCamera(45f, 16f / 9f, 0.1f, 100f);
        camera.Position.Set(2f, 1.6f, 2.6f);

        scene.Add(new AmbientLight(Color.White, 0.9f));

        var keyLight = new DirectionalLight(Color.White, 2f);
        keyLight.Position.Set(3f, 5f, 4f);
        scene.Add(keyLight);

        var fillLight = new DirectionalLight(Color.White, 0.7f);
        fillLight.Position.Set(-4f, 1f, -3f);
        scene.Add(fillLight);

        await threeContext.SetActiveSceneAsync(scene, camera);

        // The one JavaScript-to-C# callback the package makes during an operation, and bounded by the
        // fetch rather than by the frame rate. See Figure.stories.razor for the same pattern.
        var progress = new Progress<GltfLoadProgress>(report =>
        {
            _loadProgress = report;
            InvokeAsync(StateHasChanged);
        });

        var options = new GLTFLoadOptions { IsDracoEnabled = true };
        var model = await new GLTFLoader(threeContext).LoadAsync(
            _navigationManager.ToAbsoluteUri(ModelUrl).ToString(), options, progress);
        scene.Add(model.Scene);

        var orbitControls = await OrbitControls.AttachAsync(threeContext, camera);
        orbitControls.IsDampingEnabled = true;
        orbitControls.MinDistance = 1f;
        orbitControls.MaxDistance = 6f;
        orbitControls.Target.Set(0f, 0f, 0f);

        await threeContext.FlushAsync();
    }
}
