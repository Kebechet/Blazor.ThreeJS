@* Its own path in the sidebar rather than "Components/ThreeCanvas": BlazingStory keys the story tree
   by this string, so two files declaring the same one leave only whichever registers last. *@
@attribute [Stories("Addons/GLTFLoader and OrbitControls")]
@using System.Globalization
@inject NavigationManager _navigationManager

<Stories TComponent="ThreeCanvas">
    <Story Name="Load and orbit a model">
        <Template>
            <p>
                A glTF figure loaded by the browser and driven from C#. Drag to orbit, scroll to zoom,
                right-drag to pan. Click a body part to pop it out and click it again to put it back:
                the browser built those meshes, C# never saw their geometry, and it can still move them.
            </p>
            <ThreeCanvas Style="width: 100%; height: 420px;" OnReady="BuildFigureSceneAsync" />
            @* The test id is the E2E suite's hook. Without it the suite locates this by element name,
               which breaks the moment the story grows a second <strong> — as it did when the download
               readout below was added. *@
            <p>Last part clicked: <strong data-testid="last-clicked-part">@_lastClickedPartName</strong></p>
            <p>
                Download reported:
                @if (_loadProgress is null)
                {
                    <em>no progress events</em>
                }
                else if (_loadProgress.Fraction is { } fraction)
                {
                    <text><strong>@fraction.ToString("P0", CultureInfo.InvariantCulture)</strong> (@_loadProgress.BytesLoaded of @_loadProgress.BytesTotal bytes)</text>
                }
                else
                {
                    <text><strong>@_loadProgress.BytesLoaded bytes</strong>, total unknown</text>
                }
            </p>
            <p>
                ⚠️ That readout comes from the only JavaScript-to-C# callback the package makes during an
                operation. It is bounded by the fetch - a handful of events for a model - which is why it
                exists at all. three.js's per-frame hooks (<code>Renderer.setOpaqueSort</code>,
                <code>onBeforeRender</code>) are deliberately <em>not</em> exposed: a delegate invoked per
                object per frame across this boundary would be a network round trip per object on a
                Blazor Server circuit, and an idle scene costing zero interop is the property the whole
                design rests on.
            </p>
            <p>
                A total of "unknown" is normal rather than a failure: a server streaming the response,
                or compressing it without a <code>Content-Length</code>, reports no total. The API
                answers <code>null</code> there instead of zero, so a progress bar can go indeterminate
                rather than sit at 0% forever.
            </p>
            <p>
                <button disabled="@(!_isSceneReady)" @onclick="ReadCameraPositionAsync">Where is the camera?</button>
                @_cameraReadout
            </p>
        </Template>
    </Story>
</Stories>

@code {
    // Public domain (CC0), committed under demo/wwwroot/models. Resolved against the app's base href
    // so the same story works locally and under the /Blazor.ThreeJS/ path on GitHub Pages.
    private const string ModelUrl = "_content/Blazor.ThreeJS.Demo.Stories/models/figure.gltf";
    private const float PopOutDistance = 0.35f;

    private ThreeContext? _threeContext;
    private PerspectiveCamera? _camera;
    private OrbitControls? _orbitControls;
    private string _lastClickedPartName = "nothing yet";
    private GltfLoadProgress? _loadProgress;
    private string _cameraReadout = "not asked yet";

    /// <summary>
    /// Until this is true, a button's handler would find nothing to act on and return without doing
    /// anything - silently. Set last in the scene-building method, after every await that can throw, so
    /// a build that fails partway leaves the buttons disabled instead of inert but clickable.
    /// </summary>
    private bool _isSceneReady;

    private async Task BuildFigureSceneAsync(ThreeContext threeContext)
    {
        _threeContext = threeContext;

        var scene = new Scene();
        threeContext.Attach(scene);

        var camera = new PerspectiveCamera(45f, 16f / 9f, 0.1f, 100f);
        camera.Position.Set(0f, 0.4f, 3.4f);
        _camera = camera;

        scene.Add(new AmbientLight(Color.White, 0.9f));

        var keyLight = new DirectionalLight(Color.White, 2f);
        keyLight.Position.Set(3f, 5f, 4f);
        scene.Add(keyLight);

        var fillLight = new DirectionalLight(Color.White, 0.7f);
        fillLight.Position.Set(-4f, 1f, -3f);
        scene.Add(fillLight);

        await threeContext.SetActiveSceneAsync(scene, camera);

        // The one JavaScript-to-C# callback the package makes during an operation, and bounded by the
        // fetch rather than by the frame rate. See the note under the canvas.
        var progress = new Progress<GltfLoadProgress>(report =>
        {
            _loadProgress = report;
            InvokeAsync(StateHasChanged);
        });

        var model = await new GLTFLoader(threeContext).LoadAsync(_navigationManager.ToAbsoluteUri(ModelUrl).ToString(), progress);
        scene.Add(model.Scene);

        foreach (var bodyPart in model.Nodes.Where(x => x.ThreeType == "Mesh"))
        {
            var restingZ = bodyPart.Position.Z;
            bodyPart.OnClick += _ =>
            {
                bodyPart.Position.Z = bodyPart.Position.Z == restingZ ? restingZ + PopOutDistance : restingZ;
                _lastClickedPartName = bodyPart.Name;
                StateHasChanged();
            };
        }

        _orbitControls = await OrbitControls.AttachAsync(threeContext, camera);
        _orbitControls.IsDampingEnabled = true;
        _orbitControls.MinDistance = 1.5f;
        _orbitControls.MaxDistance = 8f;
        _orbitControls.Target.Set(0f, 0.2f, 0f);

        await threeContext.FlushAsync();

        _isSceneReady = true;
    }

    // The camera's mirror goes stale the moment the controls start driving it, and this is the honest
    // way to see that: what C# last wrote next to what the browser actually has, one interop call, at
    // a moment the user picked. Orbit first, then press the button.
    private async Task ReadCameraPositionAsync()
    {
        if (_orbitControls is null || _camera is null || _threeContext is null)
        {
            return;
        }

        var browserPosition = await _orbitControls.GetCameraPositionAsync();
        _cameraReadout = $"mirror says {Format(_camera.Position)}, browser says {Format(browserPosition)}";
    }

    /// <summary>
    /// Invariant rather than the browser's culture: the components are separated by commas, and a
    /// comma decimal separator turns one position into what reads as six numbers.
    /// </summary>
    private static string Format(Vector3 position)
    {
        return string.Format(CultureInfo.InvariantCulture, "({0:0.00}, {1:0.00}, {2:0.00})", position.X, position.Y, position.Z);
    }
}
