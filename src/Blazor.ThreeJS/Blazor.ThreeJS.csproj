<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Kebechet.Blazor.ThreeJS</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <!-- The doc file above ships in the package; doc-comment warnings are kept fatal so a
         misplaced, duplicate, or missing doc block cannot ship silently again. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1571;CS1572;CS1573;CS1574;CS1587;CS1591;CS1592;CS1710;CS1723;CS1734</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="NugetProperties">
    <Authors>Kebechet</Authors>
    <IsPackable>true</IsPackable>
    <PackageId>Kebechet.Blazor.ThreeJS</PackageId>
    <Description>Blazor wrapper for three.js. Typed C# scene graph with batched interop, safe on WebAssembly, Server, and MAUI Hybrid. Ships the three.js bundle — no npm, no CDN, no manual script tags.</Description>
    <RepositoryUrl>https://github.com/Kebechet/Blazor.ThreeJS</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Kebechet/Blazor.ThreeJS</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>blazor;threejs;three;3d;webgl;graphics;scene;rendering</PackageTags>
    <Version>0.185.1.1</Version>
    <PackageReleaseNotes>Fix release; three.js stays at r185. Statics now behave as three.js declares them: AnimationClip.Parse, CreateFromMorphTargetSequence and TorusGeometry.FromJSON became static factories answering the clip or geometry they build, AudioContext.SetContext and AnimationUtils.FlattenJSON became statics, and every static answering an object - FindByNameAsync, SubclipAsync, GetContextAsync - answers instead of faulting. Raycast hits decode, carrying the mesh that was hit. StencilOp.DecrementStencilOp carries the runtime's 7683 rather than the typings' typo, and BatchedMesh's bounds queries are nullable, as three.js declares them. OrbitControls accepts infinity - three.js's own maxDistance default - and rejects only NaN; attaching a new set spends the replaced wrapper, and detaching the replaced set no longer takes the live set's listeners. A declarative scene survives a conditional camera swap instead of freezing on a retired handle, and the new GLTFModel.Unload() releases everything a load kept resident.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DeterministicSourcePaths Condition="'$(GITHUB_ACTIONS)' == 'true'">true</DeterministicSourcePaths>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blazor.ThreeJS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="6.0.36" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="7.0.20" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
