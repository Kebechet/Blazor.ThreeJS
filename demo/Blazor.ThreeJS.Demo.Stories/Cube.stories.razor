@attribute [Stories("Components/ThreeCanvas")]
@implements IDisposable

<Stories TComponent="ThreeCanvas">
    <Story Name="Rotating cube">
        <Template>
            <ThreeCanvas Style="width: 100%; height: 400px;" OnReady="BuildSceneAsync" />
        </Template>
    </Story>
    <Story Name="Click to recolour">
        <Template>
            <p>Click the outer cubes to recolour them. The middle one has no subscriber, so a click passes straight through it.</p>
            <ThreeCanvas Style="width: 100%; height: 400px;" OnReady="BuildClickableSceneAsync" />
        </Template>
    </Story>
</Stories>

@code {
    private static readonly TimeSpan FrameInterval = TimeSpan.FromMilliseconds(16);
    private const float RadiansPerFrame = 0.01f;
    private static readonly int[] PaletteHexColors = [0x3366cc, 0xcc3366, 0x66cc33, 0xcc9933];

    private readonly CancellationTokenSource _animationCancellation = new();

    private async Task BuildSceneAsync(ThreeContext threeContext)
    {
        var scene = new Scene();
        threeContext.Attach(scene);

        var camera = new PerspectiveCamera(75f, 16f / 9f, 0.1f, 1000f);
        camera.Position.Set(0f, 0f, 5f);
        scene.Add(camera);

        scene.Add(new AmbientLight(Color.White, 0.4f));

        var light = new DirectionalLight(Color.White, 1f);
        light.Position.Set(5f, 5f, 5f);
        scene.Add(light);

        var material = new MeshStandardMaterial();
        material.Color.SetHex(0x3366cc);
        material.Roughness = 0.4f;

        var mesh = new Mesh(new BoxGeometry(1f, 1f, 1f), material);
        mesh.Rotation.Set(0.4f, 0.8f, 0f, EulerOrder.XYZ);
        scene.Add(mesh);

        await threeContext.SetActiveSceneAsync(scene, camera);

        _ = AnimateAsync(threeContext, mesh);
    }

    private async Task BuildClickableSceneAsync(ThreeContext threeContext)
    {
        var scene = new Scene();
        threeContext.Attach(scene);

        var camera = new PerspectiveCamera(75f, 16f / 9f, 0.1f, 1000f);
        camera.Position.Set(0f, 0f, 6f);
        scene.Add(camera);

        scene.Add(new AmbientLight(Color.White, 0.4f));

        var light = new DirectionalLight(Color.White, 1f);
        light.Position.Set(5f, 5f, 5f);
        scene.Add(light);

        var geometry = new BoxGeometry(1f, 1f, 1f);
        foreach (var (index, positionX) in new[] { -2.2f, 0f, 2.2f }.Index())
        {
            var material = new MeshStandardMaterial();
            material.Color.SetHex(PaletteHexColors.First());
            material.Roughness = 0.4f;

            var mesh = new Mesh(geometry, material);
            mesh.Position.Set(positionX, 0f, 0f);
            mesh.Rotation.Set(0.4f, 0.8f, 0f, EulerOrder.XYZ);
            scene.Add(mesh);

            if (index == 1)
            {
                continue;
            }

            var paletteIndex = 0;
            mesh.OnClick += _ =>
            {
                paletteIndex = (paletteIndex + 1) % PaletteHexColors.Length;
                material.Color.SetHex(PaletteHexColors.ElementAt(paletteIndex));
            };
        }

        await threeContext.SetActiveSceneAsync(scene, camera);
    }

    private async Task AnimateAsync(ThreeContext threeContext, Mesh mesh)
    {
        using var timer = new PeriodicTimer(FrameInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(_animationCancellation.Token))
            {
                var nextRotationY = mesh.Rotation.Y + RadiansPerFrame;
                mesh.Rotation.Y = nextRotationY >= MathF.Tau ? nextRotationY - MathF.Tau : nextRotationY;
                await threeContext.FlushAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
            // BlazingStory keeps this story component alive while swapping the rendered story, so
            // Dispose() below can run while this loop is mid-flight. Cancel() and Dispose() run
            // back to back there; if the loop is awaiting FlushAsync when that happens, the next
            // loop condition re-reads _animationCancellation.Token against an already-disposed
            // source instead of observing cancellation, so this - not OperationCanceledException -
            // is what actually stops the loop in that window.
        }
    }

    public void Dispose()
    {
        _animationCancellation.Cancel();
        _animationCancellation.Dispose();
    }
}
