<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Blazor.ThreeJS.E2E</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Same test host as tests/Blazor.ThreeJS.Tests: Microsoft.Testing.Platform, not VSTest. The two
         hosts take different command lines, and a suite that quietly used the other one would only
         announce it when someone copied a VSTest-only flag between them. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <!-- Deliberately no ProjectReference to the demo or the library. The suite drives the demo as a
       black box over HTTP, exactly as a browser does, so it sees the published static assets rather
       than the compile-time view of them. A missing wwwroot file is invisible to a project reference
       and obvious here. -->

</Project>
